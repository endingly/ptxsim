{
    "version": 8,
    "configurePresets": [
        {
            "name": "ci-linux-llvm",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Ninja",
            "environment": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-llvm.cmake"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "BUILD_TESTING": "ON",
                "VCPKG_MANIFEST_FEATURES": "tests",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-llvm.cmake"
            }
        },
        {
            "name": "ci-linux-clang-debug",
            "inherits": "ci-linux-llvm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ci-linux-clang-release",
            "inherits": "ci-linux-llvm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ci-linux-clang-asan-ubsan",
            "inherits": "ci-linux-llvm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PTXSIM_ENABLE_ASAN": "ON",
                "PTXSIM_ENABLE_UBSAN": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ci-linux-clang-debug",
            "configurePreset": "ci-linux-clang-debug",
            "configuration": "Debug"
        },
        {
            "name": "ci-linux-clang-release",
            "configurePreset": "ci-linux-clang-release",
            "configuration": "Release"
        },
        {
            "name": "ci-linux-clang-asan-ubsan",
            "configurePreset": "ci-linux-clang-asan-ubsan",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "ci-linux-clang-debug",
            "configurePreset": "ci-linux-clang-debug",
            "configuration": "Debug",
            "execution": { "jobs": 4 }
        },
        {
            "name": "ci-linux-clang-release",
            "configurePreset": "ci-linux-clang-release",
            "configuration": "Release",
            "execution": { "jobs": 4 }
        },
        {
            "name": "ci-linux-clang-asan-ubsan",
            "configurePreset": "ci-linux-clang-asan-ubsan",
            "configuration": "Debug",
            "execution": { "jobs": 4 }
        }
    ],
    "workflowPresets": [
        {
            "name": "ci-linux-clang-debug",
            "displayName": "CI Clang Debug Build + Test",
            "description": "Configure, build Debug, run tests",
            "steps": [
                { "name": "ci-linux-clang-debug", "type": "configure" },
                { "name": "ci-linux-clang-debug", "type": "build" },
                { "name": "ci-linux-clang-debug", "type": "test" }
            ]
        },
        {
            "name": "ci-linux-clang-release",
            "displayName": "CI Clang Release Build + Test",
            "description": "Configure, build Release, run tests",
            "steps": [
                { "name": "ci-linux-clang-release", "type": "configure" },
                { "name": "ci-linux-clang-release", "type": "build" },
                { "name": "ci-linux-clang-release", "type": "test" }
            ]
        },
        {
            "name": "ci-linux-clang-asan-ubsan",
            "displayName": "CI Clang ASan+UBSan Build + Test",
            "description": "Configure, build with ASan+UBSan, run tests",
            "steps": [
                { "name": "ci-linux-clang-asan-ubsan", "type": "configure" },
                { "name": "ci-linux-clang-asan-ubsan", "type": "build" },
                { "name": "ci-linux-clang-asan-ubsan", "type": "test" }
            ]
        }
    ]
}
