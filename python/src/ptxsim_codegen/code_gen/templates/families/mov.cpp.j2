{% macro adapter(form, operation) %}{% if form.kind == "scalar" %}/** @brief Prepare projected MOV scalar layout alternatives. */
auto {{ form.function_name }}(LaneResourceResolver& resolver, const arith::context&,
                const exec_ir::{{ operation.cpp_name }}::{{ form.cpp_name }}& form,
                std::optional<common::ProgramCounter> successor)
    -> std::expected<PreparedEffect, LaneFaultCause> {
  return std::visit(
      [&](const auto& operands) -> std::expected<PreparedEffect, LaneFaultCause> {
        using Operands = std::remove_cvref_t<decltype(operands)>;
{% for layout in form.layouts %}        {% if loop.first %}if constexpr{% else %}else if constexpr{% endif %} (std::same_as<Operands, exec_ir::{{ operation.cpp_name }}::{{ form.cpp_name }}::{{ layout.cpp_name }}Operands>) {
          return prepare_{{ layout.kind }}_move(resolver, form.{{ form.type_field }}, operands.{{ layout.destination }}, operands.{{ layout.source }}, successor);
        }
{% endfor %}        else {
          static_assert(!std::same_as<Operands, Operands>, "unrouted projected MOV layout");
        }
      }, form.operands);
}
{% elif form.kind == "vector" %}/** @brief Prepare the projected topology vector MOV form. */
auto {{ form.function_name }}(LaneResourceResolver& resolver, const arith::context&,
                const exec_ir::{{ operation.cpp_name }}::{{ form.cpp_name }}& form,
                std::optional<common::ProgramCounter> successor)
    -> std::expected<PreparedEffect, LaneFaultCause> {
  return prepare_vector_special_move(resolver, form.{{ form.vector_field }}, form.{{ form.type_field }},
                                     form.{{ form.destination }}, form.{{ form.source }}, successor);
}
{% else %}/** @brief Prepare the projected predicate MOV form. */
auto {{ form.function_name }}(LaneResourceResolver& resolver, const arith::context&,
                const exec_ir::{{ operation.cpp_name }}::{{ form.cpp_name }}& form,
                std::optional<common::ProgramCounter> successor)
    -> std::expected<PreparedEffect, LaneFaultCause> {
  return prepare_predicate_move(resolver, form.{{ form.destination }}, form.{{ form.source }}, successor);
}
{% endif %}{% endmacro %}
