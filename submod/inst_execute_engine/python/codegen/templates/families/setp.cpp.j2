{% macro adapter(form, operation_name) %}/** @brief Prepare the projected {{ operation_name }}::{{ form.cpp_name }} integer comparison. */
auto {{ form.function_name }}(LaneResourceResolver& resolver, const arith::context& arithmetic,
                const exec_ir::{{ operation_name }}::{{ form.cpp_name }}& form,
                std::optional<common::ProgramCounter> successor)
    -> std::expected<PreparedEffect, LaneFaultCause> {
  return std::visit(
      [&](const auto& operands) -> std::expected<PreparedEffect, LaneFaultCause> {
        return prepare_integer_setp(
            resolver, arithmetic, form.type, form.comparison,
            {% if form.boolean %}form.boolean, &operands.combine{% else %}std::nullopt, nullptr{% endif %},
            exec_ir::SetpDestination{operands.dst},
            operands.src1, operands.src2, successor);
      }, form.operands);
}
{% endmacro %}
